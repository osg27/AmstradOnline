+#ifdef UAE_NO_THREADS
+static void cdda_tick_end (struct cdunit *cdu)
+{
+	if (!cdu->tk_active)
+		return;
+	next_cd_audio_buffer_callback(-1, cdu);
+	if (cd_audio_mode_changed)
+		audio_cda_new_buffer(&cdu->cas, NULL, -1, -1, NULL, NULL);
+#ifdef __LIBRETRO__
+	cda_delete();
+#else
+	delete cdu->cda;
+#endif
+	cdu->tk_active = false;
+	cd_audio_mode_changed = false;
+	write_log (_T("IMAGE CDDA: cooperative player stopped\n"));
+}
+
+static void cdda_tick_unit (struct cdunit *cdu)
+{
+	if (!cdu->tk_active) {
+		if (cdu->cdda_play <= 0)
+			return;
+		cdu->tk_active = true;
+		memset(&cdu->cas, 0, sizeof(struct cd_audio_state));
+		cdu->cda_bufon[0] = cdu->cda_bufon[1] = 0;
+		cdu->tk_bufnum = 0;
+		cdu->tk_oldplay = -1;
+		cdu->tk_oldtrack = -1;
+		cdu->tk_first = true;
+		cdu->tk_pos = cdu->cdda_start;
+		cd_audio_mode_changed = false;
+#ifdef __LIBRETRO__
+		cda_new (CDDA_BUFFERS, 2352, 44100);
+#else
+		cdu->cda = new cda_audio (CDDA_BUFFERS, 2352, 44100);
+#endif
+	}
+
+	if (cd_audio_mode_changed && cdu->cdda_play > 0) {
+		/* audio mode changed: restart from the current position */
+		int pos = cdu->tk_pos;
+		cdda_tick_end (cdu);
+		cdu->cdda_start = pos;
+		if (cdu->cdda_start + 150 >= cdu->cdda_end) {
+			cdu_setstate (cdu, AUDIO_STATUS_PLAY_COMPLETE, cdu->cdda_end + 1);
+			cdu->cdda_play = 0;
+		}
+		return;
+	}
+	if (cdu->cdda_play <= 0) {
+		cdda_tick_end (cdu);
+		cdu->cdda_play = 0;
+		return;
+	}
+
+	if (cdu->tk_oldplay != cdu->cdda_play) {
+		struct cdtoc *t;
+		int sector;
+		if (cdu->cdda_paused)
+			return;
+		cdu->tk_idleframes = 0;
+		cdu->tk_silentframes = 0;
+		cdu->tk_pos = cdu->cdda_start;
+		cdu->tk_oldplay = cdu->cdda_play;
+		sector = cdu->cd_last_pos = cdu->tk_pos;
+		t = findtoc (cdu, &sector, false);
+		if (!t) {
+			sector = cdu->cd_last_pos = cdu->tk_pos + 2 * 75;
+			t = findtoc (cdu, &sector, false);
+			if (!t) {
+				write_log (_T("IMAGE CDDA: illegal sector number %d\n"), cdu->cdda_start);
+				cdu_setstate (cdu, AUDIO_STATUS_PLAY_ERROR, -1);
+			} else {
+				audio_unpack (cdu, t);
+			}
+		} else {
+			cdu->tk_oldtrack = t->track;
+			audio_unpack (cdu, t);
+		}
+		cdu->tk_idleframes = cdu->cdda_delay_frames;
+		cdu->tk_pos -= cdu->tk_idleframes;
+		cdu_setstate (cdu, AUDIO_STATUS_IN_PROGRESS, cdu->tk_pos);
+
+		sector = cdu->tk_pos;
+		struct cdtoc *t1 = findtoc (cdu, &sector, false);
+		int tsector = cdu->tk_pos + 2 * 75;
+		struct cdtoc *t2 = findtoc (cdu, &tsector, false);
+		if (t1 != t2) {
+			for (sector = cdu->tk_pos; sector < cdu->tk_pos + 2 * 75; sector++) {
+				int sec = sector;
+				t = findtoc (cdu, &sec, false);
+				if (t == t2)
+					break;
+				cdu->tk_silentframes++;
+			}
+		}
+	}
+
+	/* fill every free buffer (double buffered, like the threaded player) */
+	for (int n = 0; n < 2 && cdu->cdda_play > 0; n++) {
+		int bufnum = cdu->tk_bufnum;
+		if (cdu->cda_bufon[bufnum] || cdu->cdda_paused)
+			break;
+		if (cdu->tk_idleframes <= 0 && cdu->tk_pos >= cdu->cdda_start && !isaudiotrack (&cdu->di.toc, cdu->tk_pos)) {
+			cdu_setstate (cdu, AUDIO_STATUS_PLAY_ERROR, -1);
+			write_log (_T("IMAGE CDDA: attempted to play data track %d\n"), cdu->tk_pos);
+			cdu->cdda_play = -1;
+			break;
+		}
+		if (cdu->tk_pos < cdu->cdda_end || cdu->cdda_end == 0xffffffff)
+			cdda_fill_buffer (cdu, bufnum, &cdu->tk_pos, &cdu->tk_idleframes, &cdu->tk_silentframes, &cdu->tk_oldtrack, &cdu->tk_first);
+		cdu->tk_bufnum = 1 - bufnum;
+	}
+}
